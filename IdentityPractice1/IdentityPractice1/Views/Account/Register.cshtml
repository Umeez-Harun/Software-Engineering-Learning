@using ServiceContracts.DTO;
@model registerUserRequest
@{
    ViewBag.title = "Register Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
<div class="card">
    <div class="brand">
        <div class="brand-mark"></div>
        <span>Nova</span>
    </div>

    <h1>Create your account</h1>
    <p class="subtitle">Join us and get started in seconds</p>

    <form asp-controller="Account" asp-action="register" method="post">
        <div class="field">
            <input type="text" asp-for="@Model.fullName" placeholder="Full name" required />
            <span asp-validation-for="@Model.fullName"></span>
        </div>
        <div class="field">
            <input type="email" asp-for="@Model.email" placeholder="Email address" required />
            <span asp-validation-for="@Model.email"></span>
        </div>
        <div class="field">
            <input type="tel" asp-for="@Model.phoneNo" placeholder="Phone number" required />
            <span asp-validation-for="@Model.phoneNo"></span>
        </div>
        <div class="field">
            <input type="password" asp-for="@Model.password" placeholder="Password" required />
            <span asp-validation-for="@Model.password"></span>
        </div>
        <div class="field">
            <input type="password" asp-for="@Model.confirmPassword" placeholder="Confirm password" required />
            <span asp-validation-for="@Model.confirmPassword"></span>
        </div>
        <div class="row-split">
            <label class="remember">
               <input asp-for="@Model.UserType" type="radio" style="width: auto" value="Admin" />
                    Admin
            </label>
            <label class="remember">
               <input asp-for="@Model.UserType" type="radio" style="width: auto" value="Accountant" />
                    Accountant
            </label>
            </div>
        <button type="submit" class="btn-primary">Sign Up</button>
    </form>

    <div class="divider"><span>or continue with</span></div>

    <a href="#" class="btn-social">
        <svg viewBox="0 0 24 24" fill="#1877F2">
            <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.86c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z" />
        </svg>
        Login with Facebook
    </a>

    <p class="footer-text">
        Already have an account? <a asp-action="login" asp-controller="Account">Log in</a>
    </p>
</div>
</div>

