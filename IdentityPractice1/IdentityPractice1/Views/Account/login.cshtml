@using ServiceContracts.DTO;
@model LoginRequest
@{
    ViewBag.title = "Login Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="card">
        <div class="brand">
            <div class="brand-mark"></div>
            <span>Nova</span>
        </div>

        <h1>Welcome back</h1>
        <p class="subtitle">Log in to continue to your account</p>

        <form asp-controller="Account" asp-action="login" asp-route-ReturnUrl="@Context.Request.Query["ReturnUrl"]" method="post">
            <div class="field">
                <input asp-for="@Model.email" type="email" placeholder="Email address" required />
                <span asp-validation-for="@Model.email" style="color:red"></span>
            </div>
            <div class="field">
                <input asp-for="@Model.password" type="password" placeholder="Password" required />
                <span asp-validation-for="@Model.password" style="color:red"></span>
            </div>

            <div class="row-split">
                <label class="remember">
                    <input asp-for="@Model.rememberMe" type="checkbox" style="width: auto" />
                    Remember me
                </label>
                <a href="#">Forgot password?</a>
            </div>

            <button type="submit" class="btn-primary">Log In</button>
        </form>

        <div class="divider"><span>or continue with</span></div>

        <a href="#" class="btn-social">
            <svg viewBox="0 0 24 24" fill="#1877F2">
                <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.86c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z" />
            </svg>
            Login with Facebook
        </a>

        <p class="footer-text">
            Don't have an account? <a href="/" >Sign up</a>
        </p>
    </div>
</div>
