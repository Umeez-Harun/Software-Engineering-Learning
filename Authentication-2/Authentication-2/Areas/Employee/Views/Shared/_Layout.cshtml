<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/style.css" rel="stylesheet" />
</head>
<body>
    <div class="app-page theme-employee">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-mark"></div>
                <span>Nova</span>
            </div>

            <ul class="nav-list">
                <li>
                    <a href="employee-dashboard.html" class="active">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">
                            <rect x="3" y="3" width="7" height="9" rx="1.5" />
                            <rect x="14" y="3" width="7" height="5" rx="1.5" />
                            <rect x="14" y="12" width="7" height="9" rx="1.5" />
                            <rect x="3" y="16" width="7" height="5" rx="1.5" />
                        </svg>
                        Dashboard
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a asp-controller="Account" asp-action="logout" asp-area="" class="btn-logout">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <path d="M16 17l5-5-5-5" />
                        <path d="M21 12H9" />
                    </svg>
                    Log out
                </a>
            </div>
        </aside>

        @RenderBody()
    </div>
</body>
</html>
